# Copy to .env (ignored by Git) or set in the hosting panel (Vercel/Render). Never commit real values.

# LLM provider used by the four agents: groq (default) or gemini.
LLM_PROVIDER=groq
# Secret: Groq API key (create it at console.groq.com). Leave empty to run with rules only.
GROQ_API_KEY=
# Groq model with strict JSON-schema outputs.
GROQ_MODEL=openai/gpt-oss-120b

# Alternative provider (optional).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Customers reviewed by the LLM per analysis (highest risk first). 10 fits free-tier tokens per minute.
LLM_MAX_CUSTOMERS=10
# Provider calls allowed per day (all agents together).
LLM_DAILY_LIMIT=50
# Public analyses with LLM allowed per day.
PUBLIC_LLM_DAILY_LIMIT=10

# Secret: optional admin key for the private history endpoints (Bearer token).
APP_API_KEY=
# Optional: PostgreSQL URL for durable history and shared quotas. Default is a local SQLite file.
DATABASE_URL=sqlite:///runtime/churn.db
PORT=8000
